{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.splice-data.io/workflow-bundle/bundle/v0.3.0/schema.json",
  "title": "SPLICE workflow bundle index (bundle.json)",
  "description": "Published index of one workflow bundle: workflow identity, citation and contact metadata, the five workflow-bundle contract revisions and the bundle file index.",
  "type": "object",
  "required": [
    "bundle_format",
    "schema_id",
    "schema_version",
    "generated_by",
    "pipeline",
    "schemas",
    "files"
  ],
  "properties": {
    "bundle_format": {
      "const": "splice-pipeline-bundle"
    },
    "schema_id": {
      "const": "https://schemas.splice-data.io/workflow-bundle/bundle"
    },
    "schema_version": {
      "const": "0.3.0"
    },
    "generated_by": {
      "$ref": "#/$defs/generated_by"
    },
    "pipeline": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "engine",
        "repository_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "enum": [
            "nextflow"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "long_description": {
          "type": "string",
          "minLength": 1
        },
        "readme": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "project_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "release_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        },
        "funders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "award_id": {
                "type": "string",
                "minLength": 1
              },
              "award_title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            },
            "additionalProperties": false
          }
        },
        "citation": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "doi": {
              "type": "string",
              "pattern": "^10\\.[0-9]{4,9}/\\S+$"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "cff_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "licence_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "documentation_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "support_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "engine_version_min": {
          "type": "string",
          "minLength": 1
        },
        "engine_versions_tested": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "pipeline_type": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "type": "string",
          "minLength": 1
        },
        "released_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "affiliation": {
            "type": "string",
            "minLength": 1
          },
          "contact_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      }
    },
    "schemas": {
      "type": "object",
      "required": [
        "https://schemas.splice-data.io/workflow-bundle/bundle",
        "https://schemas.splice-data.io/workflow-bundle/inputs",
        "https://schemas.splice-data.io/workflow-bundle/outputs",
        "https://schemas.splice-data.io/workflow-bundle/components",
        "https://schemas.splice-data.io/workflow-bundle/execution-profiles"
      ],
      "propertyNames": {
        "enum": [
          "https://schemas.splice-data.io/workflow-bundle/bundle",
          "https://schemas.splice-data.io/workflow-bundle/inputs",
          "https://schemas.splice-data.io/workflow-bundle/outputs",
          "https://schemas.splice-data.io/workflow-bundle/components",
          "https://schemas.splice-data.io/workflow-bundle/execution-profiles"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "path"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "required": [
        "inputs_schema",
        "outputs_catalogue",
        "outputs_schema",
        "ro_crate",
        "components",
        "execution_profiles"
      ],
      "properties": {
        "inputs_schema": {
          "$ref": "#/$defs/relative_path"
        },
        "outputs_catalogue": {
          "$ref": "#/$defs/relative_path"
        },
        "outputs_schema": {
          "$ref": "#/$defs/relative_path"
        },
        "ro_crate": {
          "$ref": "#/$defs/relative_path"
        },
        "components": {
          "$ref": "#/$defs/relative_path"
        },
        "execution_profiles": {
          "$ref": "#/$defs/relative_path"
        }
      },
      "additionalProperties": false
    },
    "default_execution_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "generated_by": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "person",
            "organization"
          ]
        },
        "affiliation": {
          "type": "string",
          "minLength": 1
        },
        "orcid": {
          "type": "string",
          "pattern": "^https://orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    }
  }
}
