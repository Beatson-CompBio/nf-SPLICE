{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.splice-data.io/workflow-bundle/components/v0.3.0/schema.json",
  "title": "SPLICE workflow component and container inventory (components.json)",
  "description": "Reviewed workflow components and their container identities, distinguishing native OCI/registry sources from independently downloadable, checksum-verified image distributions.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "generated_by",
    "pipeline",
    "require_downloadable_images",
    "containers",
    "components"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.splice-data.io/workflow-bundle/components"
    },
    "schema_version": {
      "const": "0.3.0"
    },
    "generated_by": {
      "$ref": "#/$defs/generated_by"
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    },
    "require_downloadable_images": {
      "type": "boolean"
    },
    "containers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "generated_by": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "engine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "container": {
      "type": "object",
      "required": [
        "id",
        "type",
        "uri",
        "source_images",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^container-[0-9a-f]{12}$"
        },
        "type": {
          "enum": [
            "docker",
            "singularity",
            "apptainer",
            "oras"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "source_images": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "docker": {
              "type": "string",
              "minLength": 1
            },
            "singularity": {
              "type": "string",
              "minLength": 1
            },
            "apptainer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "distribution": {
          "type": "object",
          "required": [
            "download_uri",
            "sha256",
            "size_bytes",
            "filename",
            "format",
            "cache_filename",
            "source_runtime"
          ],
          "properties": {
            "download_uri": {
              "type": "string",
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "sif",
                "img"
              ]
            },
            "cache_filename": {
              "type": "string",
              "minLength": 1
            },
            "source_runtime": {
              "enum": [
                "singularity",
                "apptainer"
              ]
            },
            "source_image_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "resolution": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "discovered",
                "needs_review",
                "resolved",
                "needs_materialisation",
                "published",
                "verified",
                "blocked"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "legacy_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^container-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "path",
        "namespace",
        "tool",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "workflow_module"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "container_id": {
          "type": "string",
          "pattern": "^container-[0-9a-f]{12}$"
        },
        "conda_packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
