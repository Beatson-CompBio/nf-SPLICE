{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.splice-data.io/workflow-bundle/execution-profiles/v0.3.0/schema.json",
  "title": "SPLICE workflow execution profile catalogue (execution-profiles.json)",
  "description": "Reviewed execution environments, their configuration files and the single reviewed platform default profile.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "generated_by",
    "pipeline",
    "profiles"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.splice-data.io/workflow-bundle/execution-profiles"
    },
    "schema_version": {
      "const": "0.3.0"
    },
    "generated_by": {
      "$ref": "#/$defs/generated_by"
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    },
    "default_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "generated_by": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "engine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "type",
        "engine",
        "executor",
        "config",
        "default",
        "config_strategy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "test",
            "development",
            "production"
          ]
        },
        "engine": {
          "enum": [
            "nextflow"
          ]
        },
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "container_engine": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "config": {
          "type": "string",
          "pattern": "^configs/[a-z][a-z0-9_-]*\\.config$"
        },
        "default": {
          "type": "boolean"
        },
        "config_strategy": {
          "enum": [
            "adopted",
            "authored"
          ]
        },
        "site_parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
