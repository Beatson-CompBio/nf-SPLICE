# nf-SPLICE ignore rules.
#
# Generic build and environment directories are anchored to the repository
# root (leading "/") so that fixture pipelines under tests/fixtures/ can keep
# directories such as lib/, bin/, conf/ or results/ without being silently
# dropped. Check a new rule with `git check-ignore -v <path>` and confirm that
# `git ls-files -ci --exclude-standard` stays empty.

# --- Python bytecode and native extensions --------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so

# --- Packaging and build output (repository root only) --------------------
/build/
/dist/
/sdist/
/wheels/
/downloads/
/develop-eggs/
/eggs/
/parts/
/lib/
/lib64/
/var/
/share/python-wheels/
.Python
.eggs/
*.egg-info/
*.egg
.installed.cfg
/MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# --- Test, coverage and type-checker caches -------------------------------
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py.cover
/cover/
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/
cython_debug/

# --- Virtual environments and local environment files ---------------------
.venv/
/venv/
/env/
/ENV/
/env.bak/
/venv.bak/
.python-version.local
.pdm-python
.pdm-build/
__pypackages__/
.pixi/
.envrc
.env
.env.*
!.env.example

# --- Credentials and private keys (never commit) ---------------------------
.pypirc
.netrc
.npmrc
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
credentials.json
service-account*.json
.streamlit/secrets.toml

# --- Notebooks and interactive tools ---------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py
marimo/_static/
marimo/_lsp/
__marimo__/
.abstra/
tempCodeRunnerFile.py

# --- Editors and IDEs (personal settings) ----------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo
*~
\#*\#
.\#*

# --- Operating-system metadata ----------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Logs and runtime state -------------------------------------------------
*.log
*.pid

# --- Nextflow runs started from the repository root ------------------------
.nextflow/
.nextflow.log*
.nextflow.pid
/work/
/results/

# --- Container images (large binaries; publish via a registry instead) ----
*.sif
*.img

# --- AI assistant personal files -------------------------------------------
# A shared .claude/settings.json may be committed deliberately, so only the
# personal overrides are ignored.
/.claude/settings.local.json
/CLAUDE.local.md

# --- nf-SPLICE local development workspace ---------------------------------
# All agent scratch files, temporary test output, caches, logs, local TUI
# sessions, reports and ephemeral fixtures live below this one anchored,
# ignored directory inside the clone. It is never part of the published
# splice/ bundle and must never be staged (see scripts/check_staged_paths.py).
/.nf-splice-local/
