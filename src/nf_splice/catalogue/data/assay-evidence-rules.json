{
  "format": "nf-splice-assay-evidence-rules/1",
  "version": "2026-10-16",
  "about": "Deterministic links from repository evidence to SPLICE vocabulary entities. An 'establishes' rule shows the pipeline processes data of its target entity (a domain-level fact). A 'suggests' rule is distinguishing evidence for a more specific assay below an established entity; it never establishes anything by itself and never confirms a capability. Terms are matched case-insensitively: tool terms against module, process, container and conda package names; parameter terms against parameter names and allowed values; text terms against documentation and parameter descriptions; output terms against published output paths; samplesheet terms against sample sheet columns.",
  "rules": [
    {
      "id": "bulk-short-read-rnaseq",
      "role": "establishes",
      "target": 255,
      "basis": "Read alignment or pseudo-alignment to a transcriptome or genome followed by gene or transcript quantification, and RNA-specific quality control, is the processing of short-read RNA sequencing libraries.",
      "signals": {
        "tool": ["salmon", "rsem", "featurecounts", "htseq", "stringtie", "kallisto", "deseq2", "edger", "rseqc", "qualimap", "dupradar", "star", "hisat2", "tximport", "tximeta"],
        "parameter": ["aligner", "pseudo_aligner", "strandedness", "gtf", "transcript_fasta"],
        "text": ["rna-seq", "rnaseq", "gene expression", "transcript quantification", "differential expression"],
        "output": ["salmon", "rsem", "featurecounts", "star_salmon", "quant"],
        "samplesheet": ["strandedness"]
      },
      "require_kinds": ["tool"],
      "min_distinct": 3
    },
    {
      "id": "polya-selection",
      "role": "suggests",
      "target": 232,
      "basis": "Poly(A) selection (oligo-dT capture of polyadenylated transcripts) is the library preparation that defines poly(A) RNA-seq.",
      "signals": {
        "parameter": ["polya", "poly_a"],
        "text": ["polya", "poly-a", "poly(a)", "oligo-dt", "oligo(dt)", "mrna-seq", "polyadenylated"]
      },
      "min_distinct": 1
    },
    {
      "id": "ribosomal-depletion",
      "role": "suggests",
      "target": 312,
      "basis": "Ribosomal RNA depletion is the library preparation of total RNA-seq. In-silico rRNA removal options (such as SortMeRNA) are consistent with ribo-depleted libraries but are also used with poly(A) data, so they suggest rather than confirm.",
      "signals": {
        "tool": ["sortmerna", "ribodetector"],
        "parameter": ["remove_ribo_rna", "ribo_database", "ribo_database_manifest"],
        "text": ["total rna", "ribo-zero", "ribozero", "riboerase", "rrna depletion", "ribosomal rna depletion", "ribo-depleted", "ribodepleted"]
      },
      "min_distinct": 1
    },
    {
      "id": "droplet-single-cell-rnaseq",
      "role": "establishes",
      "target": 341,
      "basis": "Cell-barcode and UMI demultiplexing of droplet libraries (Cell Ranger, STARsolo, alevin, kallisto|bustools) is the processing of droplet-based single-cell RNA-seq.",
      "signals": {
        "tool": ["cellranger", "starsolo", "alevin", "alevinfry", "simpleaf", "bustools", "cellbender", "emptydrops"],
        "parameter": ["chemistry", "barcode_whitelist", "cb_whitelist", "expected_cells", "protocol"],
        "text": ["single-cell", "single cell", "scrna-seq", "scrnaseq", "10x genomics", "chromium", "droplet"],
        "output": ["cellranger", "alevin", "starsolo", "filtered_feature_bc_matrix"]
      },
      "require_kinds": ["tool"],
      "min_distinct": 2
    },
    {
      "id": "chromium-3-prime",
      "role": "suggests",
      "target": 1,
      "basis": "3' gene expression chemistries (SC3P, 10x v2 and v3) capture transcript 3' ends.",
      "signals": {
        "parameter": ["sc3pv3", "sc3pv2", "10xv3", "10xv2", "sc3p"],
        "text": ["3' gene expression", "3 prime", "3-prime", "sc3p", "10xv3", "10xv2"]
      },
      "min_distinct": 1
    },
    {
      "id": "chromium-5-prime",
      "role": "suggests",
      "target": 2,
      "basis": "5' gene expression chemistries (SC5P) capture transcript 5' ends and are used with immune profiling.",
      "signals": {
        "parameter": ["sc5p", "sc5p-pe", "sc5p-r2"],
        "text": ["5' gene expression", "5 prime", "5-prime", "sc5p"]
      },
      "min_distinct": 1
    },
    {
      "id": "plate-based-single-cell-rnaseq",
      "role": "establishes",
      "target": 342,
      "basis": "Full-length, plate-based single-cell protocols are processed per cell without droplet barcodes.",
      "signals": {
        "text": ["smart-seq", "smartseq", "plate-based", "full-length single-cell"],
        "parameter": ["smartseq"]
      },
      "min_distinct": 1
    },
    {
      "id": "imaging-spatial-transcriptomics",
      "role": "establishes",
      "target": 138,
      "basis": "Processing of in-situ imaging transcript detections (Xenium, CosMx, MERFISH) is imaging-based spatial transcriptomics.",
      "signals": {
        "tool": ["xeniumranger", "baysor", "proseg", "spatialdata"],
        "text": ["xenium", "cosmx", "atomx", "merscope", "merfish", "in situ transcript"],
        "output": ["transcripts.parquet", "cell_boundaries"]
      },
      "min_distinct": 1
    },
    {
      "id": "xenium",
      "role": "suggests",
      "target": 11,
      "basis": "10x Genomics Xenium output and tooling.",
      "signals": {"tool": ["xeniumranger"], "text": ["xenium"]},
      "min_distinct": 1
    },
    {
      "id": "cosmx",
      "role": "suggests",
      "target": 37,
      "basis": "Bruker CosMx SMI output and tooling.",
      "signals": {"text": ["cosmx", "atomx"]},
      "min_distinct": 1
    },
    {
      "id": "atac-seq",
      "role": "establishes",
      "target": 38,
      "basis": "Tn5 insertion-site analysis with peak calling and fragment-size or nucleosome QC is the processing of ATAC-seq chromatin accessibility data.",
      "signals": {
        "tool": ["macs2", "macs3", "genrich", "ataqv", "hmmratac", "nucleoatac"],
        "parameter": ["tn5", "narrow_peak", "macs_gsize", "frip_threshold"],
        "text": ["atac", "chromatin accessibility", "nucleosome", "tn5"]
      },
      "require_kinds": ["tool"],
      "min_distinct": 2
    },
    {
      "id": "dna-methylation",
      "role": "establishes",
      "target": 79,
      "basis": "Bisulfite-aware alignment and methylation calling (Bismark, bwa-meth, MethylDackel) is the processing of bisulfite sequencing for DNA methylation.",
      "signals": {
        "tool": ["bismark", "bwameth", "methyldackel", "biscuit", "methylkit"],
        "parameter": ["cytosine_report", "non_directional", "comprehensive"],
        "text": ["bisulfite", "methylation", "cpg"]
      },
      "require_kinds": ["tool"],
      "min_distinct": 2
    },
    {
      "id": "rrbs",
      "role": "suggests",
      "target": 238,
      "basis": "Reduced representation (MspI-digested) libraries need RRBS-specific trimming and deduplication rules.",
      "signals": {"parameter": ["rrbs"], "text": ["rrbs", "reduced representation"]},
      "min_distinct": 1
    },
    {
      "id": "wgbs",
      "role": "suggests",
      "target": 335,
      "basis": "Whole-genome bisulfite sequencing covers the whole genome without enrichment.",
      "signals": {"text": ["wgbs", "whole-genome bisulfite", "whole genome bisulfite"]},
      "min_distinct": 1
    },
    {
      "id": "targeted-bisulfite",
      "role": "suggests",
      "target": 343,
      "basis": "Targeted bisulfite sequencing restricts analysis to captured regions.",
      "signals": {"parameter": ["target_regions", "targeted"], "text": ["targeted bisulfite", "capture panel", "target regions"]},
      "min_distinct": 1
    },
    {
      "id": "shotgun-metagenomics",
      "role": "establishes",
      "target": 345,
      "basis": "Community profiling or assembly of whole microbial communities from shotgun reads (MetaPhlAn, HUMAnN, MEGAHIT) is shotgun metagenomics. Kraken2 or Bracken alone are also used for contamination screening and do not establish it.",
      "signals": {
        "tool": ["metaphlan", "humann", "megahit", "metaspades", "kraken2", "bracken", "centrifuge", "kaiju"],
        "text": ["metagenom", "microbiome", "shotgun metagenomic"]
      },
      "require_kinds": ["tool"],
      "require_terms": ["metaphlan", "humann", "megahit", "metaspades", "metagenom"],
      "min_distinct": 2
    },
    {
      "id": "whole-slide-imaging",
      "role": "establishes",
      "target": 340,
      "basis": "Tiling and analysis of whole-slide images (OpenSlide, QuPath, HoVer-Net) is whole-slide histopathology imaging.",
      "signals": {
        "tool": ["openslide", "qupath", "hovernet", "histolab", "tiatoolbox", "stardist"],
        "text": ["whole slide", "whole-slide", "histopatholog", ".svs", ".ndpi"]
      },
      "require_kinds": ["tool"],
      "min_distinct": 2
    },
    {
      "id": "he-staining",
      "role": "suggests",
      "target": 123,
      "basis": "Haematoxylin and eosin is the routine histological stain.",
      "signals": {"text": ["h&e", "hematoxylin", "haematoxylin", "eosin"]},
      "min_distinct": 1
    },
    {
      "id": "video-cage-monitoring",
      "role": "establishes",
      "target": 327,
      "basis": "Pose estimation and tracking of animals in home-cage video is video cage monitoring.",
      "signals": {
        "tool": ["deeplabcut", "sleap", "bonsai", "idtracker"],
        "text": ["home cage", "home-cage", "video", "cage monitoring"]
      },
      "require_kinds": ["tool"],
      "min_distinct": 2
    }
  ]
}
