{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/org/legacy-example/splice/inputs.schema.json",
  "title": "legacy-example configurable inputs",
  "description": "Reviewed parameters configurable when running legacy-example through the SPLICE platform.",
  "type": "object",
  "$defs": {
    "analysis": {
      "title": "Analysis",
      "description": "",
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "description": "Analysis threshold.",
          "default": 0.8,
          "minimum": 0
        }
      }
    },
    "input_output_options": {
      "title": "Input/output options",
      "description": "",
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "format": "file-path",
          "description": "Samplesheet.",
          "mimetype": "text/csv"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/analysis"
    },
    {
      "$ref": "#/$defs/input_output_options"
    }
  ],
  "unevaluatedProperties": false
}
