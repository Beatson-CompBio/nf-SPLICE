manifest {
    name            = 'example-org/histoseg'
    version         = '0.4.0'
    homePage        = 'https://github.com/example-org/histoseg'
    description     = 'Nuclear segmentation and morphology features for H&E whole-slide images.'
    author          = 'Grace Hopper'
    license         = 'Apache-2.0'
    nextflowVersion = '!>=24.04.0'
}

params {
    input          = null
    outdir         = null
    tile_size      = 1024
    normalisation  = 'macenko'
    min_area_px    = 30
    save_masks     = true
}

includeConfig 'conf/base.config'

profiles {
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true }
    gpu         { includeConfig 'conf/gpu.config' }
}
