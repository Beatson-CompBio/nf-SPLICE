process {
    withName: 'ALIGN_BISULFITE' {
        publishDir = [ path: { "${params.outdir}/alignments" }, mode: 'copy',
                       saveAs: { name -> name.endsWith('.bam') ? name : null } ]
    }
    withName: 'DEDUPLICATE' {
        publishDir = [ path: { "${params.outdir}/deduplicated" }, mode: 'copy' ]
    }
    withName: 'CALL_METHYLATION' {
        publishDir = [ path: { "${params.outdir}/methylation" }, mode: 'copy' ]
    }
    withName: 'SUMMARISE' {
        publishDir = [ path: { "${params.outdir}/summary" }, mode: 'copy' ]
    }
}
