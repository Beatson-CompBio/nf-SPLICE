manifest {
    name        = 'example-org/methylseq-lite'
    version     = '2.1.0'
    homePage    = 'https://github.com/example-org/methylseq-lite'
    description = 'Bisulfite alignment and CpG methylation calling.'
    license     = 'MIT'
}

params {
    input       = null
    outdir      = null
    genome      = null
    skip_dedup  = false
    min_depth   = 5
    context     = 'CpG'
}

includeConfig 'conf/containers.config'
includeConfig 'conf/publish.config'
