{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/org/rnaquant/splice/inputs.schema.json",
  "type": "object",
  "x-splice-contract": {
    "id": "https://schemas.splice-data.io/workflow-bundle/inputs",
    "version": "0.3.0",
    "generated_by": {
      "name": "nf-splice",
      "version": "0.3.0"
    }
  },
  "x-splice-pipeline": {
    "id": "rnaquant",
    "name": "rnaquant",
    "version": "1.2.0",
    "engine": "nextflow"
  },
  "$defs": {
    "analysis": {
      "title": "Analysis",
      "type": "object",
      "required": [
        "threshold"
      ],
      "properties": {
        "threshold": {
          "type": "number",
          "description": "Analysis threshold.",
          "default": 0.8,
          "x-splice-source": {
            "engine": "nextflow",
            "binding": "params.threshold",
            "origin": "nextflow_schema.json#/$defs/analysis/properties/threshold"
          },
          "x-splice-access": {
            "editable_by": [
              "agent",
              "user"
            ]
          }
        },
        "outdir": {
          "type": "string",
          "description": "Output directory.",
          "x-splice-source": {
            "engine": "nextflow",
            "binding": "params.outdir",
            "origin": "nextflow_schema.json#/$defs/analysis/properties/outdir"
          },
          "x-splice-access": {
            "editable_by": [
              "platform"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/analysis"
    }
  ]
}
