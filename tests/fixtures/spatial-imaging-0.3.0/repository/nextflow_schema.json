{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "input_output": {
      "title": "Input and output",
      "type": "object",
      "required": ["input", "outdir"],
      "properties": {
        "input": {
          "type": "string",
          "format": "file-path",
          "mimetype": "text/csv",
          "description": "Sample sheet: one row per slide region (sample,bundle)."
        },
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "description": "Results directory."
        }
      }
    },
    "analysis": {
      "title": "Analysis",
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["xenium", "cosmx"],
          "default": "xenium",
          "description": "Imaging platform that produced the runs."
        },
        "segmentation_model": {
          "type": "string",
          "enum": ["cyto3", "nuclei"],
          "default": "cyto3",
          "description": "Cellpose model used for segmentation."
        }
      }
    }
  },
  "allOf": [
    {"$ref": "#/$defs/input_output"},
    {"$ref": "#/$defs/analysis"}
  ]
}
