manifest {
    name            = 'org/spatialcells'
    version         = '0.4.0'
    description     = 'Cell segmentation and cell-by-gene matrices for imaging-based spatial transcriptomics.'
    homePage        = 'https://github.com/org/spatialcells'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    input              = null
    outdir             = 'results'
    platform           = 'xenium'
    segmentation_model = 'cyto3'
}

process {
    withLabel: 'process_gpu' {
        accelerator = 1
    }
}

profiles {
    k8s { includeConfig 'conf/k8s.config' }
}
