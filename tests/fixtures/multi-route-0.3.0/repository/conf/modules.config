process {
    withName: 'HISAT2_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/hisat2" },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: '.*:SALMON_QUANT|SALMON_QUANT' {
        publishDir = [
            path: { "${params.outdir}/salmon/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
